{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "Latest complete day",
      "queryLines": [
        "WITH complete AS (SELECT CAST(event_hour AS DATE) AS d FROM gold_latency_hourly GROUP BY CAST(event_hour AS DATE) HAVING COUNT(DISTINCT event_hour) = 24), latest AS (SELECT MAX(d) AS day FROM complete) SELECT l.day AS latest_day, (SELECT SUM(approved) * 1.0 / SUM(auths) FROM gold_daily_approval WHERE event_date = l.day) AS approval_rate, (SELECT SUM(declines) FROM gold_decline_reasons WHERE event_date = l.day) AS declines, (SELECT COUNT(*) FROM gold_anomalies WHERE CAST(period_start AS DATE) = l.day) AS flags_latest_day, (SELECT COUNT(*) FROM gold_anomalies WHERE CAST(period_start AS DATE) > date_sub(l.day, 7)) AS flags_last_7_days FROM latest l "
      ]
    },
    {
      "name": "ds_day",
      "displayName": "Approval rate by day",
      "queryLines": [
        "SELECT event_date, SUM(auths) AS auths, SUM(approved) AS approved, SUM(approved) * 1.0 / SUM(auths) AS approval_rate FROM gold_daily_approval GROUP BY event_date ORDER BY event_date "
      ]
    },
    {
      "name": "ds_declines",
      "displayName": "Declines by response code",
      "queryLines": [
        "SELECT event_date, response_code, SUM(declines) AS declines FROM gold_decline_reasons GROUP BY event_date, response_code ORDER BY event_date "
      ]
    },
    {
      "name": "ds_latency",
      "displayName": "Peak latency by region",
      "queryLines": [
        "SELECT CAST(event_hour AS DATE) AS event_date, region, MAX(p95_latency_ms) AS peak_p95_ms FROM gold_latency_hourly GROUP BY CAST(event_hour AS DATE), region ORDER BY event_date "
      ]
    },
    {
      "name": "ds_flags",
      "displayName": "Flags",
      "queryLines": [
        "SELECT CAST(period_start AS DATE) AS event_date, period_start, detector, entity, observed, baseline, score FROM gold_anomalies ORDER BY period_start DESC, score DESC "
      ]
    }
  ],
  "pages": [
